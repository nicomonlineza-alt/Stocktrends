# Copy this value into the hosting provider's server-side environment settings.
# Never put a real API key in this file or commit a real .env file.
TWELVE_DATA_API_KEY=replace_with_your_private_key

# Public client configuration for the authenticated cloud learning journal.
# These values may be exposed to the browser; never place service-role keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
